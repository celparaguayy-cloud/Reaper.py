+"""
+Proyectos GRANDES por etapas (/grande).
+
+Un /construir mete todo el pedido en UN plan de hasta max_tareas tareas y un plazo de pared: alcanza para un proyecto
+chico o mediano, pero uno grande (una app con backend, base de datos, frontend, autenticación, panel…) terminaba con
+las tareas sobrantes amontonadas en la última o cortado por el plazo. Acá:
+
+1. Un PLAN MAESTRO divide el pedido en etapas. Cada etapa es una porción que se puede construir y probar sola, con
+   los archivos que toca, la INTERFAZ que deja para las siguientes y sus criterios.
+2. Cada etapa es un /construir completo, con TODAS sus guardas (tests primero, juez, preservación de lo anterior,
+   examen de realidad, arranque). Los tests de las etapas anteriores quedan protegidos: una etapa nueva no puede
+   debilitarlos para pasar.
+3. Si una etapa no queda verificada, NO se construye nada encima (se reintenta una vez retomando su build y, si
+   sigue mal, se frena y se informa). /grande continuar retoma donde quedó, aunque se haya cortado a mitad.
+4. Al final, una verificación de INTEGRACIÓN sobre todo el proyecto y el juez contra el PEDIDO ORIGINAL (no contra
+   lo que escribió el modelo). Si falta algo, una build de integración acotada lo completa.
+
+Lo que el modelo escribe en el plan maestro NUNCA autoriza nada: reescribir archivos previos o aceptar "datos de
+ejemplo" se decide con el pedido del usuario (Orquestador.pedido_usuario).
+"""
+
+# Los modelos reales no siempre respetan el castellano del formato: <stage>, <fase>, <phase> también valen.
+_ETIQUETA_ETAPA = r"(?:etapa|stage|fase|phase)"
+_RE_ETAPA = re.compile(rf"<{_ETIQUETA_ETAPA}\b([^>]*)>(.*?)</{_ETIQUETA_ETAPA}\s*>", re.S | re.I)
+_RE_ETAPA_ABIERTA = re.compile(rf"<{_ETIQUETA_ETAPA}\b[^>]*>", re.I)
+_RE_ETAPA_CERRADA = re.compile(rf"</{_ETIQUETA_ETAPA}\s*>", re.I)
+_SINONIMOS = {"objetivo": ("objetivo", "objective", "goal"), "archivos": ("archivos", "files"),
+              "interfaz": ("interfaz", "interface"), "criterios": ("criterios", "criteria", "acceptance"),
+              "vision": ("vision", "visión", "overview"), "arquitectura": ("arquitectura", "architecture")}
+_SIN_DEPENDENCIAS = {"ninguna", "ninguno", "none", "no", "-", "—", "0", "n/a", "na", "nada", "[]"}
+_RE_ATTR_ETAPA = re.compile(r"""(\w+)\s*=\s*["']([^"']*)["']""")
+# Intentos TOTALES por etapa (entre todas las invocaciones) antes de pedir intervención: no quemar tokens en bucle.
+# Solo cuentan las builds que TERMINARON: un corte por límite del modelo, Ctrl+C o el teléfono no es culpa de la etapa.
+MAX_INTENTOS_ETAPA = 4
+# Esperas ante límites PASAJEROS (todos los modelos en enfriamiento, 429 por minuto, proveedor caído un rato).
+ESPERAS_LIMITE = (120, 300, 600)
+_RE_LIMITE_PASAJERO = re.compile(r"enfriamiento|429|rate|satura|50[0-4]|timeout|no respondi|red |network|"
+                                 r"vac[ií]a|overloaded|temporar|unavailable|cort[oó] el streaming", re.I)
+ESTADOS_OK_ETAPA = ("verificada", "validada")
+_DIARIO_ILEGIBLE = "el diario de la build de esta etapa no se puede usar"
+
+MISION_MAESTRO = """Sos el ARQUITECTO DE UN PROYECTO GRANDE. No escribís código: dividís el pedido en ETAPAS que otro
+equipo va a construir UNA POR VEZ, cada una con su propio plan, sus tests y su verificación.
+
+Reglas:
+- Cada etapa entrega código REAL, completo y que se puede probar SOLO (con tests automáticos), sobre lo que dejaron
+  las anteriores. Nada de esqueletos, stubs, placeholders, TODO, `pass`, NotImplementedError ni "datos de ejemplo
+  para completar después": lo que una etapa crea, lo termina.
+- Orden por dependencias: primero la base (modelo de datos, núcleo, configuración), después lo que la usa. Preferí
+  porciones verticales que funcionen de punta a punta antes que capas sueltas.
+- Cada etapa entra en un plan de ~4 a 10 tareas: si es más grande, partila. Si es más chica, AGRUPALA con otra:
+  apuntá a 3–6 etapas en un proyecto mediano (varios CRUD o varias tablas en UNA etapa, no una etapa por archivo).
+- Cada etapa trae SUS tests. NO hagas etapas de solo tests ("pruebas de integración"): REAPER ya verifica el
+  proyecto entero al final.
+- Si el pedido NOMBRA archivos (p. ej. web/index.html, app.js, style.css), alguna etapa tiene que crearlos.
+- Definí la ARQUITECTURA una sola vez (stack, carpetas, cómo se corren los tests y la app, convenciones) y que
+  todas las etapas la respeten.
+- La INTERFAZ de cada etapa (archivos, funciones/clases/endpoints con firmas exactas) es un contrato: las etapas
+  siguientes la usan tal cual y no la rompen.
+- NO agregues etapas de solo "ejecutar/verificar pruebas" ni de "documentación" suelta: REAPER verifica todo.
+- Usá solo lo que el entorno tiene (Termux/Linux: Python y su librería estándar, Node si hace falta). No inventes
+  servicios, claves ni datos: si algo viene de afuera, la etapa lo obtiene de verdad.
+
+Respondé EXACTAMENTE con este formato (nada antes ni después):
+<maestro>
+<vision>qué es el producto terminado, en 2-4 frases</vision>
+<arquitectura>
+stack, estructura de carpetas, comando de tests, cómo se arranca, convenciones
+</arquitectura>
+<etapa id="1" titulo="nombre corto" deps="">
+<objetivo>qué queda funcionando al terminar esta etapa</objetivo>
+<archivos>ruta/a.py, ruta/b.py, tests/test_a.py</archivos>
+<interfaz>
+- ruta/a.py: def funcion(param: tipo) -> tipo — qué devuelve
+</interfaz>
+<criterios>
+- criterio comprobable con un test (entrada → salida esperada)
+</criterios>
+</etapa>
+<etapa id="2" titulo="..." deps="1">
+...
+</etapa>
+</maestro>"""
+
+
+@dataclass
+class Etapa:
+    id: str
+    titulo: str
+    objetivo: str
+    archivos: list = field(default_factory=list)
+    interfaz: str = ""
+    criterios: list = field(default_factory=list)
+    deps: list = field(default_factory=list)
+    estado: str = "pendiente"           # pendiente | en_curso | verificada | validada | parcial | fallida | cancelada
+    intentos: int = 0
+    informe: str = ""                   # ruta del informe de la última build de la etapa
+    motivo: str = ""                    # por qué no quedó verificada (el error REAL, recortado)
+    segundos: float = 0.0
+    consumo: int = 0                    # tokens (entrada + salida) de sus builds
+    pedidos: int = 0                    # pedidos al modelo de sus builds (lo que cuenta para el cupo diario gratis)
+    origen: str = ""                    # si es una parte de una etapa que falló y se partió: el id de la original
+
+    @property
+    def ok(self) -> bool:
+        return self.estado in ESTADOS_OK_ETAPA
+
+
+@dataclass
+class PlanMaestro:
+    vision: str
+    arquitectura: str
+    etapas: list
+    texto: str = ""
+    cortado: bool = False               # la respuesta del modelo terminó a mitad de una etapa
+
+    def por_id(self, eid: str) -> Optional[Etapa]:
+        return next((e for e in self.etapas if e.id == eid), None)
+
+    def como_texto(self) -> str:
+        lineas = [f"Visión: {self.vision}"]
+        if self.arquitectura:
+            lineas.append("Arquitectura:")
+            lineas.extend(f"  {l.strip()}" for l in self.arquitectura.strip().splitlines() if l.strip())
+        for e in self.etapas:
+            deps = f" (después de {', '.join(e.deps)})" if e.deps else ""
+            lineas.append(f"[{e.estado}] Etapa {e.id} · {e.titulo}{deps}: {recortar(e.objetivo, 300)}")
+        return "\n".join(lineas)
+
+
+def _tag(cuerpo: str, nombre: str) -> str:
+    for variante in _SINONIMOS.get(nombre, (nombre,)):
+        m = re.search(rf"<{variante}>(.*?)</{variante}\s*>", cuerpo or "", re.S | re.I)
+        if m:
+            return m.group(1).strip()
+    return ""
+
+
+_RE_PREFIJO_ETAPA = re.compile(r"^(?:etapa|stage|fase|phase|e)\s*#?\s*", re.I)
+
+
+def _id_corto(eid: str) -> str:
+    return _RE_PREFIJO_ETAPA.sub("", str(eid).strip()).lower()
+
+
+def _separar_deps(texto: str) -> list:
+    """'1, 2' · '1 2' · 'etapa 2, E1' → ['1', '2'] · ['1', '2'] · ['etapa 2', 'E1'] (sin partir 'etapa 2')."""
+    salida = []
+    for parte in re.split(r"[,;]+", texto or ""):
+        parte = parte.strip()
+        if not parte:
+            continue
+        if re.match(r"^(?:etapa|stage|fase|phase)\s+#?\S+$", parte, re.I):
+            salida.append(parte)
+        else:
+            salida.extend(parte.split())
+    return salida
+
+
+def _normalizar_deps(deps: list, ids: list) -> list:
+    """'ninguna' → sin deps; 'E1' / 'etapa 1' / '1' → el id real de esa etapa (comparando sin prefijo). Lo que no
+    coincide con ninguna queda tal cual y la validación lo marca (no se inventa a qué etapa se refería)."""
+    por_corto = {_id_corto(i): i for i in ids}
+    salida = []
+    for d in deps:
+        limpio = d.strip().strip("\"'[](){}.")
+        if not limpio or limpio.lower() in _SIN_DEPENDENCIAS:
+            continue
+        if limpio not in ids:
+            limpio = por_corto.get(_id_corto(limpio), limpio)
+        if limpio not in salida:
+            salida.append(limpio)
+    return salida
+
+
+def _lista_criterios(texto: str) -> list:
+    salida = []
+    for linea in (texto or "").splitlines():
+        linea = re.sub(r"^\s*([-*•]|\d+[.)])\s*", "", linea).strip()
+        if linea:
+            salida.append(linea)
+    return salida
+
+
+def _rutas_etapa(texto: str) -> list:
+    """Rutas relativas sanas: sin absolutas, sin '..', sin basura de markdown."""
+    salida = []
+    for parte in re.split(r"[,;\n]+", texto or ""):
+        rel = parte.strip().strip("`'\"*-• ").strip()
+        if not rel or " " in rel or rel.startswith(("/", "~")) or ".." in Path(rel).parts:
+            continue
+        if rel not in salida:
+            salida.append(rel)
+    return salida
+
+
+def parsear_maestro(texto: str) -> PlanMaestro:
+    """Plan maestro desde la respuesta del modelo. Tolerante con el formato; no inventa etapas que no vinieron."""
+    texto = texto or ""
+    etapas = []
+    for m in _RE_ETAPA.finditer(texto):
+        attrs = {k.lower(): v for k, v in _RE_ATTR_ETAPA.findall(m.group(1))}
+        cuerpo = m.group(2)
+        objetivo = _tag(cuerpo, "objetivo") or re.sub(r"<[^>]+>", " ", cuerpo).strip()[:400]
+        if not objetivo:
+            continue
+        eid = (attrs.get("id") or str(len(etapas) + 1)).strip()
+        dep_txt = attrs.get("deps") or attrs.get("depends") or attrs.get("depende") or attrs.get("after") or ""
+        deps = _separar_deps(dep_txt)
+        etapas.append(Etapa(eid, (attrs.get("titulo") or attrs.get("title") or f"Etapa {eid}").strip()[:80],
+                            objetivo, _rutas_etapa(_tag(cuerpo, "archivos")), _tag(cuerpo, "interfaz"),
+                            _lista_criterios(_tag(cuerpo, "criterios"))[:10], deps))
+    ids = [e.id for e in etapas]
+    for e in etapas:
+        e.deps = _normalizar_deps(e.deps, ids)
+    # Una etapa que abre y no cierra = la respuesta se cortó (tope de tokens): antes esa etapa se perdía en silencio.
+    cortado = len(_RE_ETAPA_ABIERTA.findall(texto)) > len(_RE_ETAPA_CERRADA.findall(texto))
+    return PlanMaestro(_tag(texto, "vision"), _tag(texto, "arquitectura"), etapas, texto, cortado)
+
+
+def problemas_maestro(maestro: PlanMaestro, max_etapas: int, pedido: str = "") -> list:
+    """Determinista (0 tokens): lo que hace que un plan maestro no sirva. → razones para replanificar."""
+    salida = []
+    if getattr(maestro, "cortado", False):
+        salida.append("tu respuesta se CORTÓ a mitad de una etapa (se pierden las que faltan): respondé más "
+                      "corto — objetivos y criterios en una línea, interfaz solo con las firmas")
+    if not maestro.etapas:
+        return salida + ["no vino ninguna <etapa> con el formato pedido"]
+    if len(maestro.etapas) > max_etapas:
+        salida.append(f"trae {len(maestro.etapas)} etapas y el tope es {max_etapas}: agrupá etapas chicas "
+                      "(cada etapa puede tener hasta ~10 tareas)")
+    ids = [e.id for e in maestro.etapas]
+    repetidos = sorted({i for i in ids if ids.count(i) > 1})
+    if repetidos:
+        salida.append(f"ids de etapa repetidos: {', '.join(repetidos)}")
+    for e in maestro.etapas:
+        for d in e.deps:
+            if d not in ids:
+                salida.append(f"la etapa {e.id} depende de '{d}', que no existe")
+    if GrafoTareas(maestro.etapas).tiene_ciclo():
+        salida.append("las dependencias entre etapas forman un ciclo")
+    # Las mismas reglas que un plan de tareas: nada de simular ni de etapas que solo corren pruebas.
+    como_plan = Plan(maestro.vision, [Tarea(e.id, f"{e.objetivo}\n{e.interfaz}", e.archivos, e.deps)
+                                      for e in maestro.etapas], [])
+    salida.extend(p.replace("la tarea", "la etapa") for p in problemas_del_plan(como_plan, pedido))
+    return salida
+
+
+_RE_ARCHIVO_PEDIDO = re.compile(r"(?<![\w/.-])((?:[\w-]+/)*[\w-]+\.(?:py|js|mjs|cjs|jsx|ts|tsx|html|htm|css))\b", re.I)
+
+
+def archivos_nombrados(pedido: str) -> list:
+    """Archivos de código/web que el PEDIDO nombra explícitamente (sin los de tests: sus nombres son libres)."""
+    salida = []
+    for m in _RE_ARCHIVO_PEDIDO.finditer(pedido or ""):
+        rel = m.group(1)
+        if not _es_test(rel) and rel not in salida:
+            salida.append(rel)
+    return salida
+
+
+def observaciones_maestro(maestro: PlanMaestro, pedido: str = "") -> list:
+    """Determinista (0 tokens): defectos que valen UNA replanificación pero no frenan el proyecto si el modelo insiste
+    (la integración final contra el pedido igual los atrapa). Vistos en la primera prueba REAL de /grande: el pedido
+    nombraba web/index.html, app.js y style.css y ninguna de las 10 etapas los creaba; una etapa era solo de tests;
+    y había una etapa por cada CRUD."""
+    salida = []
+    planeados = {Path(rel).name.lower() for e in maestro.etapas for rel in e.archivos}
+    faltan = [rel for rel in archivos_nombrados(pedido) if Path(rel).name.lower() not in planeados]
+    if faltan:
+        salida.append("el pedido nombra " + ", ".join(faltan[:8]) + " y NINGUNA etapa los crea: agregalos a la etapa "
+                      "que corresponda")
+    for e in maestro.etapas:
+        if e.archivos and all(_es_test(rel) for rel in e.archivos):
+            salida.append(f"la etapa {e.id} solo tiene tests: los tests van con el código de cada etapa; fusionala")
+    codigo = sorted(sum(1 for rel in e.archivos if not _es_test(rel)) for e in maestro.etapas)
+    if len(maestro.etapas) > 6 and codigo and codigo[len(codigo) // 2] <= 1:
+        salida.append(f"el plan está muy fragmentado ({len(maestro.etapas)} etapas, la mayoría de un solo archivo): "
+                      "agrupá piezas relacionadas y apuntá a 3–6 etapas")
+    return salida
+
+
+def _fusionar_etapas(grupo: list, nuevo_id: str) -> Etapa:
+    def unicos(valores):
+        return list(dict.fromkeys(v for v in valores if v))
+    return Etapa(nuevo_id, recortar(" + ".join(e.titulo for e in grupo), 140),
+                 "\n".join(f"- {e.titulo}: {e.objetivo}" for e in grupo) if len(grupo) > 1 else grupo[0].objetivo,
+                 unicos(a for e in grupo for a in e.archivos),
+                 "\n".join(e.interfaz.strip() for e in grupo if e.interfaz.strip()),
+                 unicos(c for e in grupo for c in e.criterios), [])
+
+
+def normalizar_maestro(maestro: PlanMaestro, max_grupos: int = 6) -> list:
+    """Determinista (0 tokens), cuando el modelo INSISTE con un plan defectuoso después de la replanificación:
+    - una etapa de solo tests se une a la etapa cuyo código prueba (la que depende de ella, o la anterior);
+    - un plan fragmentado (más de `max_grupos` etapas, la mayoría de un archivo; prueba real: 10 etapas, una por CRUD)
+      se agrupa en tramos contiguos del orden de dependencias (así ninguna dependencia apunta hacia adelante).
+    Modifica el plan y devuelve los avisos; si el resultado no fuera un grafo válido, no toca nada."""
+    avisos = []
+    orden = [replace(e, archivos=list(e.archivos), criterios=list(e.criterios), deps=list(e.deps))
+             for e in GrafoTareas(maestro.etapas).orden()]
+    # 1) etapas de solo tests
+    i = 0
+    while i < len(orden) and len(orden) > 1:
+        etapa = orden[i]
+        if not etapa.archivos or not all(_es_test(a) for a in etapa.archivos):
+            i += 1
+            continue
+        destino = next((e for e in orden[i + 1:] if etapa.id in e.deps), None) or (orden[i - 1] if i > 0 else orden[1])
+        destino.archivos = list(dict.fromkeys(destino.archivos + etapa.archivos))
+        destino.criterios = list(dict.fromkeys(destino.criterios + etapa.criterios))
+        destino.deps = [d for d in dict.fromkeys(destino.deps + etapa.deps) if d not in (etapa.id, destino.id)]
+        for e in orden:
+            if e is not etapa:
+                e.deps = [d for d in dict.fromkeys(destino.id if d == etapa.id else d for d in e.deps) if d != e.id]
+        orden.pop(i)
+        avisos.append(f"la etapa {etapa.id} era solo de tests: la uní a la etapa {destino.id}")
+    # 2) fragmentado
+    codigo = sorted(sum(1 for rel in e.archivos if not _es_test(rel)) for e in orden)
+    if len(orden) > max_grupos and codigo and codigo[len(codigo) // 2] <= 1:
+        n, g = len(orden), max_grupos
+        tamanos = [n // g + (1 if k < n % g else 0) for k in range(g)]
+        nuevas, mapa, pos = [], {}, 0
+        for tam in tamanos:
+            grupo = orden[pos:pos + tam]
+            pos += tam
+            nueva = _fusionar_etapas(grupo, grupo[0].id)
+            for e in grupo:
+                mapa[e.id] = nueva.id
+            nueva.deps = list(dict.fromkeys(mapa.get(d, d) for e in grupo for d in e.deps
+                                            if mapa.get(d, d) != nueva.id))
+            nuevas.append(nueva)
+        avisos.append(f"el plan seguía fragmentado ({n} etapas): lo agrupé en {len(nuevas)}")
+        orden = nuevas
+    if not avisos:
+        return []
+    ids = {e.id for e in orden}
+    grafo = GrafoTareas(orden)
+    if grafo.tiene_ciclo() or any(d not in ids for e in orden for d in e.deps):
+        return []
+    maestro.etapas = grafo.orden()
+    return avisos
+
+
+def partir_etapa(etapa: Etapa, motivo: str) -> Optional[tuple]:
+    """Una etapa que falló se parte en dos más chicas (0 tokens): la mitad de sus archivos de código con sus tests y el
+    resto. None si no se puede partir (menos de 2 archivos de código)."""
+    codigo = [a for a in etapa.archivos if not _es_test(a)]
+    tests = [a for a in etapa.archivos if _es_test(a)]
+    if len(codigo) < 2:
+        return None
+    mitad = (len(codigo) + 1) // 2
+    partes = []
+    for k, cod in enumerate((codigo[:mitad], codigo[mitad:])):
+        tallos = {Path(c).stem.lower() for c in cod}
+        if k == 0:
+            suyos = [t for t in tests if any(tallo in Path(t).stem.lower() for tallo in tallos)]
+        else:
+            suyos = [t for t in tests if t not in partes[0].archivos]
+        archivos = cod + suyos
+        interfaz = "\n".join(l for l in etapa.interfaz.splitlines()
+                             if not re.search(r"[\w/.-]+\.\w{1,5}", l) or any(a in l for a in archivos))
+        objetivo = (f"{etapa.objetivo}\nEN ESTA PARTE ({k + 1} de 2) construí SOLO: {', '.join(archivos)}."
+                    + (f"\nLa etapa entera falló antes ({recortar(motivo, 300)}): hacelo más simple y verificable."
+                       if motivo else ""))
+        partes.append(Etapa(f"{etapa.id}{'ab'[k]}", f"{etapa.titulo} (parte {k + 1} de 2)", objetivo, archivos,
+                            interfaz, list(etapa.criterios) if k == 1 else [],
+                            list(etapa.deps) if k == 0 else [f"{etapa.id}a"] + list(etapa.deps), origen=etapa.id))
+    return partes[0], partes[1]
+
+
+def pedido_de_etapa(pedido: str, maestro: PlanMaestro, etapa: Etapa) -> str:
+    """El pedido que recibe el /construir de UNA etapa. Determinista (mismo texto en cada intento): así una build de
+    etapa cortada a mitad se reconoce y se RETOMA en vez de empezar otra."""
+    orden = [e for e in GrafoTareas(maestro.etapas).orden()]
+    previas = orden[:orden.index(etapa)] if etapa in orden else []
+    siguientes = orden[orden.index(etapa) + 1:] if etapa in orden else []
+    n = len(maestro.etapas)
+    partes = [f"PROYECTO GRANDE — ETAPA {etapa.id} de {n}: {etapa.titulo}",
+              f"PEDIDO ORIGINAL DEL USUARIO (contexto; NO lo construyas entero ahora):\n{recortar(pedido, 2500)}"]
+    if maestro.vision:
+        partes.append(f"VISIÓN DEL PRODUCTO:\n{recortar(maestro.vision, 800)}")
+    if maestro.arquitectura:
+        partes.append(f"ARQUITECTURA ACORDADA (respetala):\n{recortar(maestro.arquitectura, 1500)}")
+    if previas:
+        bloque = []
+        for e in previas:
+            bloque.append(f"- Etapa {e.id} · {e.titulo}: {recortar(e.objetivo, 200)}")
+            if e.interfaz:
+                bloque.extend(f"    {l.strip()}" for l in e.interfaz.strip().splitlines()[:12] if l.strip())
+        partes.append("YA CONSTRUIDO EN ETAPAS ANTERIORES (está en el proyecto y tiene tests; usá estas interfaces "
+                      "tal cual y NO las rompas):\n" + "\n".join(bloque))
+    esta = [f"Objetivo: {etapa.objetivo}"]
+    if etapa.archivos:
+        esta.append("Archivos: " + ", ".join(etapa.archivos))
+    if etapa.interfaz:
+        esta.append("Interfaz que tiene que quedar disponible:\n" + etapa.interfaz.strip())
+    if etapa.criterios:
+        esta.append("Criterios de aceptación:\n" + "\n".join(f"- {c}" for c in etapa.criterios))
+    partes.append("CONSTRUÍ AHORA SOLO ESTA ETAPA, completa y con tests reales:\n" + "\n".join(esta))
+    if siguientes:
+        partes.append("NO construyas todavía (lo hacen etapas posteriores): "
+                      + "; ".join(f"{e.titulo}" for e in siguientes))
+    return "\n\n".join(partes)
+
+
+def comando_para_seguir(ws, modo: str, settings: Optional[Settings] = None) -> str:
+    """El comando exacto para retomar desde la terminal (lo que hay que tipear después de un corte). Si la corrida usa
+    modelos :free de OpenRouter, lleva --perfil gratis: sin eso, retomar con la config de siempre podía caer en un
+    modelo PAGO (o en uno gratis viejo que ya no existe)."""
+    ruta = str(getattr(ws, "raiz", ws))
+    casa = str(Path.home())
+    if ruta == casa or ruta.startswith(casa + os.sep):
+        ruta = "~" + ruta[len(casa):]
+        visible = ruta if not re.search(r"[^\w./~-]", ruta) else '~/' + shlex.quote(ruta[2:])
+    else:
+        visible = shlex.quote(ruta)
+    perfil = " --perfil gratis" if settings is not None and usa_free_openrouter(settings) else ""
+    return f"reaper --proyecto {visible}{perfil} --{modo} continuar"
+
+
+def pista_para_seguir(ws: Workspace, settings: Optional[Settings] = None) -> str:
+    """Si en la carpeta quedó un /grande o un /construir sin terminar, cómo seguirlo ('' si no hay nada)."""
+    try:
+        grande = ConstructorGrande(None, ws, Settings(), None).leer()
+        if grande and grande.get("estado") != "terminado":
+            return f"El proyecto grande quedó guardado. Para seguir: {comando_para_seguir(ws, 'grande', settings)}"
+        build = RegistroBuild(ws).leer()
+        if build and build.get("estado") not in ESTADOS_OK_ETAPA:
+            return f"La build quedó guardada. Para seguir: {comando_para_seguir(ws, 'construir', settings)}"
+    except (ValueError, OSError, KeyError, TypeError):
+        return ""
+    return ""
+
+
+def _redactar_textos(valor):
+    """Copia con redactar_secretos aplicado a cada string (las claves y los números quedan como están)."""
+    if isinstance(valor, str):
+        return redactar_secretos(valor)
+    if isinstance(valor, dict):
+        return {k: _redactar_textos(v) for k, v in valor.items()}
+    if isinstance(valor, list):
+        return [_redactar_textos(v) for v in valor]
+    return valor
+
+
+class ConstructorGrande:
+    """Orquesta un proyecto por etapas. `construir_build(pedido_etapa, reanudar, pedido_usuario)` corre UN
+    /construir y devuelve su InformeBuild (en la App suma estadísticas y hooks; en los tests, un Orquestador)."""
+
+    ESQUEMA = 1
+
+    def __init__(self, llm, ws: Workspace, settings: Settings, ui: UI,
+                 construir_build: Optional[Callable[..., "InformeBuild"]] = None):
+        self.llm, self.ws, self.settings, self.ui = llm, ws, settings, ui
+        self.ruta = ws.carpeta_reaper() / "proyecto_grande.json"
+        self._construir_build = construir_build or self._build_directo
+        self.consultar_cuenta: Callable[[], Optional["CuentaOpenRouter"]] = self._consultar_cuenta_real
+        self.dormir: Callable[[float], None] = self._dormir_cancelable
+        self._cuenta_cache: Optional[tuple] = None
+        self._integracion_reparada = False      # UNA build de integración por corrida (no por proyecto)
+
+    # ------------------------------------------------------------ cupo y esperas
+    def _consultar_cuenta_real(self) -> Optional["CuentaOpenRouter"]:
+        if self.settings is None or not usa_free_openrouter(self.settings):
+            return None
+        return cuenta_openrouter(clave_de_proveedor("openrouter", self.settings))
+
+    def _cuenta(self) -> Optional["CuentaOpenRouter"]:
+        if self._cuenta_cache is None:
+            try:
+                self._cuenta_cache = (self.consultar_cuenta(),)
+            except (OSError, ValueError, TypeError, AttributeError):
+                self._cuenta_cache = (None,)
+        return self._cuenta_cache[0]
+
+    def _cupo_chico(self) -> bool:
+        cuenta = self._cuenta()
+        return bool(cuenta is not None and cuenta.cupo_dia is not None and cuenta.cupo_dia <= 50)
+
+    def _aviso_cupo(self, maestro: PlanMaestro) -> None:
+        """Antes de arrancar: cuántos pedidos puede llevar y cuántos quedan hoy. Un proyecto grande con 50 pedidos
+        gratis por día NO termina en un día: mejor saberlo antes que a mitad de camino."""
+        cuenta = self._cuenta()
+        if cuenta is None:
+            return
+        torneo = self.settings.torneo and not self._cupo_chico()
+        minimo, maximo = estimar_pedidos_grande(len(maestro.etapas), replace(self.settings, torneo=torneo))
+        self.ui.info(f"  Pedidos estimados al modelo: ~{minimo}–{maximo} · tu cuenta: {cuenta.resumen()}")
+        if cuenta.quedan_hoy is not None and cuenta.quedan_hoy < minimo:
+            self.ui.aviso("  Con lo que queda hoy no alcanza para todo: avanzo lo que se pueda y, cuando se agote el "
+                          "cupo, me detengo limpio (nada queda a medias sin guardar). Seguí después con: "
+                          + comando_para_seguir(self.ws, "grande", self.settings))
+
+    def _ahorro_de_pedidos(self) -> Callable[[], None]:
+        """Cuenta con 50 pedidos gratis por día: sin torneo ni revisor en ESTA corrida (cada candidato del torneo es
+        una implementación entera). Tu configuración vuelve a como estaba al terminar."""
+        if not self._cupo_chico() or not (self.settings.torneo or self.settings.max_revisiones):
+            return lambda: None
+        antes = (self.settings.torneo, self.settings.max_revisiones)
+        self.settings.torneo, self.settings.max_revisiones = False, 0
+        self.ui.tenue("  Ahorro de pedidos (cupo de 50 por día): sin torneo ni revisor en esta corrida.")
+
+        def restaurar() -> None:
+            self.settings.torneo, self.settings.max_revisiones = antes
+        return restaurar
+
+    def _espera_para(self, error: LLMError, esperado: float, esperas: int) -> float:
+        """Segundos a esperar antes de reintentar la etapa (0 = no esperar, detenerse). Acotado por
+        settings.espera_limites_min en TOTAL por etapa: no se queda colgado horas."""
+        tope = max(0, int(getattr(self.settings, "espera_limites_min", 30))) * 60
+        if not tope or error.presupuesto:
+            return 0.0
+        if error.cupo_diario:
+            if not error.reinicio:
+                return 0.0
+            falta = error.reinicio - time.time() + 30
+            return falta if 0 < falta <= tope - esperado else 0.0
+        if not _RE_LIMITE_PASAJERO.search(str(error)) or esperas >= len(ESPERAS_LIMITE):
+            return 0.0
+        espera = float(ESPERAS_LIMITE[esperas])
+        return espera if esperado + espera <= tope else 0.0
+
+    @staticmethod
+    def _dormir_cancelable(segundos: float) -> None:
+        fin = time.monotonic() + segundos
+        while time.monotonic() < fin:
+            if "CANCELAR" in globals() and CANCELAR.is_set():
+                raise Cancelado()
+            time.sleep(min(1.0, max(0.0, fin - time.monotonic())))
+
+    # ------------------------------------------------------------ estado en disco
+    def leer(self) -> Optional[dict]:
+        if not self.ruta.is_file():
+            return None
+        try:
+            datos = json.loads(self.ruta.read_text(encoding="utf-8"))
+        except (OSError, ValueError) as e:
+            raise ValueError(f"Estado de /grande ilegible ({self.ruta.name}): {e}")
+        if not isinstance(datos, dict) or datos.get("esquema") != self.ESQUEMA or "maestro" not in datos:
+            raise ValueError(f"Estado de /grande con formato desconocido ({self.ruta.name})")
+        return datos
+
+    def guardar(self, estado: dict, maestro: PlanMaestro) -> None:
+        estado["maestro"] = asdict(maestro)
+        estado["actualizado"] = datetime.now().isoformat(timespec="seconds")
+        # Se redactan los TEXTOS, no el JSON serializado: redactar_secretos tomaba `"tokens": 1234` por una
+        # credencial, lo cambiaba por [REDACTADO] y el estado quedaba ilegible (lo atrapó el autotest de /grande).
+        escritura_atomica(self.ruta, json.dumps(_redactar_textos(estado), ensure_ascii=False, indent=2))
+
+    def borrar(self) -> None:
+        if self.ruta.is_file():
+            self.ruta.unlink()
+
+    @staticmethod
+    def maestro_de(estado: dict) -> PlanMaestro:
+        datos = estado["maestro"]
+        campos = {f.name for f in fields(Etapa)}
+        etapas = [Etapa(**{k: v for k, v in e.items() if k in campos}) for e in datos.get("etapas", [])]
+        return PlanMaestro(datos.get("vision", ""), datos.get("arquitectura", ""), etapas, datos.get("texto", ""))
+
+    # ------------------------------------------------------------ plan maestro
+    def _pedir_maestro(self, pedido: str, feedback: str = "", anterior: Optional[PlanMaestro] = None) -> PlanMaestro:
+        existentes = self.ws.archivos_codigo(limite=150)
+        prompt = (f"PEDIDO DEL USUARIO:\n{pedido}\n\n"
+                  f"ARCHIVOS QUE YA EXISTEN EN EL PROYECTO ({len(existentes)}):\n"
+                  + ("\n".join(f"- {a}" for a in existentes[:150]) or "(ninguno: proyecto nuevo)")
+                  + f"\n\nTope: {self.settings.max_etapas} etapas, cada una de hasta {self.settings.max_tareas} tareas.")
+        if anterior is not None and feedback:
+            prompt += (f"\n\nTU PLAN MAESTRO ANTERIOR:\n{anterior.como_texto()}\n\n"
+                       f"CORREGÍ ESTO:\n{feedback}")
+        modelo = self.settings.modelo_para("arquitecto")
+        resp = self.llm.chat([{"role": "system", "content": "# TU ROL: MAESTRO\n" + MISION_MAESTRO},
+                              {"role": "user", "content": prompt}],
+                             modelo=modelo, temperatura=0.3, max_tokens=max(4000, self.settings.max_tokens),
+                             rol="arquitecto")
+        maestro = parsear_maestro(str(getattr(resp, "texto", "") or ""))
+        if getattr(resp, "finish_reason", None) == "length":
+            maestro.cortado = True              # cortado por el tope aunque la última etiqueta haya cerrado
+        return maestro
+
+    def planificar(self, pedido: str, confirmar: bool) -> Optional[PlanMaestro]:
+        self.ui.fase("G", "Plan maestro (proyecto grande por etapas)")
+        maestro = self._pedir_maestro(pedido)
+        problemas = problemas_maestro(maestro, self.settings.max_etapas, pedido)
+        observaciones = observaciones_maestro(maestro, pedido) if maestro.etapas else []
+        if problemas or observaciones:
+            # Juez (0 tokens): una sola replanificación con las razones; si sigue mal, no se arranca a ciegas.
+            self.ui.aviso("  Juez · el plan maestro tiene problemas: lo hago rehacer una vez.")
+            for p in (problemas + observaciones)[:6]:
+                self.ui.tenue(f"    • {p}")
+            maestro = self._pedir_maestro(pedido, "\n".join(f"- {p}" for p in problemas + observaciones), maestro)
+            problemas = problemas_maestro(maestro, self.settings.max_etapas, pedido)
+            if not problemas:
+                # Si el modelo insiste con etapas de solo tests o un plan fragmentado, se corrige solo (0 tokens).
+                for aviso in normalizar_maestro(maestro):
+                    self.ui.aviso(f"  Juez · {aviso}")
+            for o in observaciones_maestro(maestro, pedido) if not problemas else []:
+                # Lo que no frena: queda avisado y la integración final contra el pedido lo vuelve a mirar.
+                self.ui.aviso(f"  Juez · sigue: {o} (lo vuelve a revisar la integración final)")
+            if problemas:
+                self.ui.error("El plan maestro sigue sin servir: " + "; ".join(problemas[:4]))
+                if any("tope es" in p for p in problemas):
+                    self.ui.tenue(f"  Si de verdad necesita más etapas: /config max_etapas "
+                                  f"{min(30, len(maestro.etapas))}")
+                return None
+        maestro.etapas = GrafoTareas(maestro.etapas).orden()
+        aviso_cupo = True
+        for _ in range(3):
+            self._mostrar_maestro(maestro)
+            if aviso_cupo:
+                self._aviso_cupo(maestro)
+                aviso_cupo = False
+            if not confirmar:
+                return maestro
+            if self.ui.confirmar("¿Aprobás el plan maestro y arrancamos por la etapa 1?", defecto=True):
+                return maestro
+            feedback = self.ui.preguntar("¿Qué cambiarías del plan maestro? (Enter vacío = cancelar)")
+            if not feedback:
+                return None
+            nuevo = self._pedir_maestro(pedido, feedback, maestro)
+            if problemas_maestro(nuevo, self.settings.max_etapas, pedido):
+                self.ui.aviso("  El plan corregido no cumple las reglas; te muestro el anterior.")
+            else:
+                maestro = nuevo
+                maestro.etapas = GrafoTareas(maestro.etapas).orden()
+        return None
+
+    def _mostrar_maestro(self, maestro: PlanMaestro) -> None:
+        self.ui.linea("")
+        if maestro.vision:
+            self.ui.info("  " + recortar(maestro.vision, 400))
+        if maestro.arquitectura:
+            for l in maestro.arquitectura.strip().splitlines()[:10]:
+                self.ui.tenue("    " + recortar(l.strip(), 140))
+        for e in maestro.etapas:
+            marca = "✓" if e.ok else ("✗" if e.estado in ("parcial", "fallida") else "○")
+            deps = f"  (tras {', '.join(e.deps)})" if e.deps else ""
+            self.ui.linea(f"  {marca} Etapa {e.id} · {e.titulo}{deps}")
+            self.ui.tenue(f"      {recortar(e.objetivo, 160)}")
+            if e.archivos:
+                self.ui.tenue("      archivos: " + recortar(", ".join(e.archivos), 150))
+
+    # ------------------------------------------------------------ ejecución
+    def iniciar(self, pedido: str, confirmar: bool = True) -> bool:
+        try:
+            previo = self.leer()
+        except ValueError as e:
+            self.ui.error(str(e))
+            return False
+        if previo and previo.get("estado") != "terminado":
+            if mismo_pedido(previo.get("pedido"), pedido):
+                # Repetir el MISMO comando después de un corte (Termux cerrado, teléfono bloqueado, límite del
+                # modelo) es la forma natural de "seguir": antes daba error y había que saber /grande continuar.
+                self.ui.info("Este mismo proyecto grande había quedado a medias: lo retomo donde quedó.")
+                return self.continuar()
+            self.ui.error("Ya hay OTRO proyecto grande sin terminar en esta carpeta. Seguilo con "
+                          f"`{comando_para_seguir(self.ws, 'grande', self.settings)}`, miralo con /grande estado o "
+                          "descartalo con /grande descartar (no borra archivos). Para uno nuevo usá otra carpeta "
+                          "(--proyecto).")
+            return False
+        try:
+            pendiente = RegistroBuild(self.ws).leer()
+        except ValueError as e:
+            self.ui.error(str(e))
+            return False
+        if pendiente and pendiente.get("estado") not in ESTADOS_OK_ETAPA:
+            self.ui.error("Hay un /construir sin terminar en esta carpeta: terminalo (/construir continuar) o "
+                          "descartalo (/construir descartar) antes de empezar un proyecto grande.")
+            return False
+        try:
+            maestro = self.planificar(pedido, confirmar)
+        except LLMError as e:
+            self.ui.error(f"El arquitecto no respondió el plan maestro: {recortar(str(e), 200)}")
+            return False
+        if maestro is None:
+            self.ui.tenue("Proyecto grande cancelado; no se tocó ningún archivo.")
+            return False
+        estado = {"esquema": self.ESQUEMA, "pedido": pedido, "estado": "en_curso",
+                  "creado": datetime.now().isoformat(timespec="seconds"),
+                  # Todo lo que se escriba desde acá queda en checkpoints >= cid_inicio: así la integración final
+                  # revisa el proyecto ENTERO (validación, examen de realidad, diff para el juez).
+                  "cid_inicio": self.ws.checkpoints.iniciar(f"proyecto grande: {pedido[:80]}"),
+                  "integracion": {}}
+        self.guardar(estado, maestro)
+        return self._ejecutar(estado, maestro)
+
+    def continuar(self) -> bool:
+        try:
+            estado = self.leer()
+        except ValueError as e:
+            self.ui.error(str(e))
+            return False
+        if not estado:
+            self.ui.aviso("No hay ningún proyecto grande en esta carpeta. Empezá uno con /grande <pedido>.")
+            return False
+        if estado.get("estado") == "terminado":
+            self.ui.ok("El proyecto grande ya está terminado y verificado.")
+            return True
+        maestro = self.maestro_de(estado)
+        self.ui.info("Retomo el proyecto grande: " + recortar(redactar_secretos(estado["pedido"]), 140))
+        return self._ejecutar(estado, maestro)
+
+    def _ejecutar(self, estado: dict, maestro: PlanMaestro) -> bool:
+        # Con qué modelos y ajustes corrió de verdad (con --perfil gratis no coincide con la config guardada): lo usa
+        # /reporte, que si no mostraba el modelo de la config y no el que construyó.
+        s = self.settings
+        estado["ajustes_corrida"] = {"modelo": s.modelo, "respaldos": list(s.fallbacks or []),
+                                     "roles": dict(s.modelos_rol or {}), "torneo": s.torneo,
+                                     "candidatos": s.candidatos, "tests_primero": s.tests_primero, "rpm": s.rpm,
+                                     "juez": getattr(s, "juez", None), "fecha": datetime.now().isoformat(timespec="seconds")}
+        restaurar = self._ahorro_de_pedidos()
+        try:
+            return self._ejecutar_etapas(estado, maestro)
+        finally:
+            restaurar()
+
+    def _ejecutar_etapas(self, estado: dict, maestro: PlanMaestro, inicio: Optional[float] = None) -> bool:
+        inicio = time.monotonic() if inicio is None else inicio
+        grafo = GrafoTareas(maestro.etapas)
+        for n, etapa in enumerate(grafo.orden(), start=1):
+            if etapa.ok:
+                continue
+            rotas = [d for d in grafo.dependencias(etapa.id) if not maestro.por_id(d).ok]
+            if rotas:
+                # Mismo principio que BUG-012 entre tareas: nunca construir sobre una base que no está verificada.
+                return self._detener(estado, maestro, f"la etapa {etapa.id} depende de {', '.join(rotas)}, que no "
+                                                      "quedó verificada")
+            if etapa.intentos >= MAX_INTENTOS_ETAPA:
+                # Antes: "partila o corregila a mano" (no hay comando para partirla). Ahora se parte sola si se puede.
+                if self._recuperar_etapa(estado, maestro, etapa):
+                    return self._ejecutar_etapas(estado, maestro, inicio)
+                return self._detener(estado, maestro, f"la etapa {etapa.id} ya se intentó {etapa.intentos} veces sin "
+                                                      "quedar verificada"
+                                     + (f": {_primera_linea_util(etapa.motivo)}" if etapa.motivo else "")
+                                     + ".\nPara reintentarla desde el último estado verificado: /grande deshacer y "
+                                       "después /grande continuar")
+            self.ui.linea("")
+            self.ui.titulo(f"Etapa {etapa.id} ({n}/{len(maestro.etapas)}) · {etapa.titulo}")
+            terminadas, esperado, esperas = 0, 0.0, 0
+            while True:                                  # el intento original + UNA reanudación de su misma build
+                try:
+                    informe = self._correr_etapa(estado, maestro, etapa)
+                except LLMError as e:
+                    if str(e).startswith(_DIARIO_ILEGIBLE):
+                        # No es el modelo (antes decía "el modelo no responde"): el diario de la build está roto o es
+                        # de otra carpeta (proyecto movido). Se dice qué es y cómo seguir.
+                        etapa.estado = "pendiente"
+                        return self._detener(estado, maestro, f"{e}.\nRevisalo con /construir estado; si está roto o "
+                                             "es de otra carpeta: /construir descartar (no borra archivos) y después "
+                                             "/grande continuar")
+                    espera = self._espera_para(e, esperado, esperas)
+                    if espera:
+                        # Límite pasajero (o cupo que se renueva pronto): esperar y seguir SOLO, sin perder lo hecho.
+                        self.ui.aviso(f"  {recortar(_primera_linea_util(str(e)), 140)}")
+                        self.ui.aviso(f"  Espero {formatear_duracion(espera)} y sigo solo (Ctrl+C corta; después: "
+                                      f"{comando_para_seguir(self.ws, 'grande', self.settings)}).")
+                        self.dormir(espera)
+                        esperado, esperas = esperado + espera, esperas + 1
+                        continue
+                    etapa.estado, etapa.motivo = "pendiente", recortar(str(e), 400)
+                    if e.cupo_diario:
+                        # Corto y con la HORA: el error entero en la caja se recortaba justo antes de "Se renueva…".
+                        return self._detener(estado, maestro, "se agotó el cupo diario de pedidos gratis.\n"
+                                             + (_texto_reinicio(e.reinicio) or " Se renueva en unas horas.").strip())
+                    return self._detener(estado, maestro, f"el modelo no responde ({recortar(str(e), 160)})")
+                terminadas += 1
+                if etapa.ok or informe.estado == "cancelada" or terminadas >= 2:
+                    break
+                if etapa.intentos >= MAX_INTENTOS_ETAPA:
+                    break
+                self.ui.aviso(f"  La etapa {etapa.id} quedó {etapa.estado.upper()}: la retomo una vez (sin replanificar) "
+                              "para que el reparador termine lo que falta.")
+            if not etapa.ok:
+                if informe.estado != "cancelada" and self._recuperar_etapa(estado, maestro, etapa):
+                    return self._ejecutar_etapas(estado, maestro, inicio)   # sigue con las dos partes, sin el usuario
+                return self._detener(estado, maestro, f"la etapa {etapa.id} quedó {etapa.estado.upper()}"
+                                     + (f": {_primera_linea_util(etapa.motivo)}" if etapa.motivo else ""))
+        ok = self._integrar(estado, maestro)
+        self._cierre(estado, maestro, time.monotonic() - inicio)
+        return ok
+
+    def _correr_etapa(self, estado: dict, maestro: PlanMaestro, etapa: Etapa) -> "InformeBuild":
+        pedido_etapa = pedido_de_etapa(estado["pedido"], maestro, etapa)
+        try:
+            pendiente = RegistroBuild(self.ws).leer()
+        except ValueError as e:
+            raise LLMError(f"{_DIARIO_ILEGIBLE}: {e}", probar_otro_modelo=False)
+        reanudar = bool(pendiente and pendiente.get("estado") not in ESTADOS_OK_ETAPA)
+        if reanudar and not mismo_pedido(pendiente.get("pedido"), pedido_etapa):
+            etapa.estado, etapa.motivo = "pendiente", "hay otro /construir sin terminar en la carpeta"
+            self.guardar(estado, maestro)
+            self.ui.error("Hay un /construir sin terminar que no es de esta etapa: terminalo o descartalo "
+                          "(/construir estado) y después /grande continuar.")
+            return InformeBuild("cancelada")
+        etapa.estado = "en_curso"
+        self.guardar(estado, maestro)
+        if reanudar:
+            self.ui.tenue("  Hay una build de esta etapa a medio terminar: la retomo sin replanificar.")
+        uso = getattr(self.llm, "uso", None)
+        pedidos_antes = int(getattr(uso, "llamadas", 0) or 0)
+        try:
+            informe = self._construir_build(pedido_etapa, reanudar, estado["pedido"])
+        finally:
+            etapa.pedidos += max(0, int(getattr(uso, "llamadas", 0) or 0) - pedidos_antes)
+            self.guardar(estado, maestro)
+        if informe.estado != "cancelada":
+            etapa.intentos += 1                  # solo cuenta lo que terminó (un corte no es culpa de la etapa)
+        etapa.estado = informe.estado if informe.estado != "cancelada" else "pendiente"
+        etapa.segundos += float(getattr(informe, "segundos", 0.0) or 0.0)
+        etapa.consumo += int(getattr(informe, "tokens_build", 0) or 0)
+        etapa.informe = str(informe.ruta_informe or "")
+        etapa.motivo = "" if etapa.ok else recortar(
+            informe.diagnostico or "; ".join(f"{t}: {m}" for t, m in informe.motivos_fallo.items())
+            or "; ".join(informe.notas[-3:]), 1500)
+        self.guardar(estado, maestro)
+        return informe
+
+    def _build_directo(self, pedido_etapa: str, reanudar: bool, pedido_usuario: str) -> "InformeBuild":
+        orq = Orquestador(self.llm, self.ws, self.settings, self.ui)
+        orq.pedido_usuario = pedido_usuario
+        return orq.construir("" if reanudar else pedido_etapa, confirmar=False, reanudar=reanudar)
+
+    def rotas_de_etapas_previas(self, maestro: PlanMaestro) -> dict:
+        """{etapa_id: [tests]} de etapas YA verificadas cuyos tests fallan ahora (corrida real, 0 tokens). Pasa cuando
+        una etapa nueva toca código anterior y la build falla: lo verificado quedó roto en el disco."""
+        verificados = {e.id: {rel: None for rel in e.archivos if _es_test(rel)} for e in maestro.etapas if e.ok}
+        if not any(verificados.values()):
+            return {}
+        r = ejecutar_tests(self.ws, timeout=self.settings.tests_timeout, completo=True)
+        fallan = conteo_de_resultado(r).nombres_fallados if r is not None and not r.ok else []
+        salida = {}
+        for eid, tests in verificados.items():
+            nombres = [n for n in fallan if tests and _es_de_especificacion(n, tests)]
+            if nombres:
+                salida[eid] = nombres
+        return salida
+
+    def _recuperar_etapa(self, estado: dict, maestro: PlanMaestro, etapa: Etapa) -> bool:
+        """Una etapa que quedó FALLIDA/PARCIAL tras su reintento: en vez de DETENIDO (esperando al usuario horas), UNA
+        recuperación acotada: se deshace la etapa (vuelve al último estado verificado) y se la parte en dos más chicas
+        con el motivo real del fallo como contexto. Si una de esas partes también falla, DETENIDO con el motivo real."""
+        if etapa.origen:
+            return False                                 # ya es una parte de una etapa recuperada: no se parte más
+        motivo = _primera_linea_util(etapa.motivo) if etapa.motivo else f"quedó {etapa.estado.upper()}"
+        partes = partir_etapa(etapa, motivo)
+        if partes is None or any(maestro.por_id(p.id) for p in partes):
+            return False
+        try:
+            build = RegistroBuild(self.ws).leer()
+        except ValueError:
+            return False
+        tocados = []
+        if build:
+            if build.get("estado") in ESTADOS_OK_ETAPA \
+                    or not mismo_pedido(build.get("pedido"), pedido_de_etapa(estado["pedido"], maestro, etapa)):
+                return False                             # no sé qué revertir sin tocar lo verificado: mejor detener
+            grupo = build.get("grupo")
+            tocados = self.ws.checkpoints.deshacer(grupo) if grupo in self.ws.checkpoints.ids() else []
+            RegistroBuild(self.ws).borrar()
+        # Sin diario de build (la etapa ya se deshizo con /grande deshacer): el disco ya está en lo verificado.
+        indice_de(self.ws).invalidar()
+        a, b = partes
+        posicion = next(i for i, e in enumerate(maestro.etapas) if e.id == etapa.id)
+        maestro.etapas[posicion:posicion + 1] = [a, b]
+        for e in maestro.etapas:
+            if e is not a and e is not b:
+                e.deps = [b.id if d == etapa.id else d for d in e.deps]
+        estado.setdefault("recuperaciones", []).append({"etapa": etapa.id, "motivo": recortar(motivo, 300),
+                                                        "revertidos": len(tocados)})
+        self.guardar(estado, maestro)
+        self.ui.aviso(f"  La etapa {etapa.id} no quedó verificada ({recortar(motivo, 140)}). En vez de detenerme, la "
+                      f"deshago ({len(tocados)} archivo(s) vuelven al último estado verificado) y la parto en dos "
+                      "más chicas:")
+        for parte in (a, b):
+            self.ui.tenue(f"    {parte.id} · {', '.join(parte.archivos)}")
+        return True
+
+    def deshacer_etapa(self) -> bool:
+        """Vuelve al ÚLTIMO ESTADO VERIFICADO: revierte los cambios de la etapa que quedó a medias o fallida, descarta
+        su build pendiente y la deja para rehacer con /grande continuar. Las etapas verificadas no se tocan."""
+        try:
+            estado = self.leer()
+            build = RegistroBuild(self.ws).leer()
+        except ValueError as e:
+            self.ui.error(str(e))
+            return False
+        if not estado:
+            self.ui.aviso("No hay ningún proyecto grande en esta carpeta.")
+            return False
+        maestro = self.maestro_de(estado)
+        etapa = next((e for e in maestro.etapas if not e.ok and e.estado != "pendiente"), None) or next(
+            (e for e in maestro.etapas if not e.ok), None)
+        if not build or build.get("estado") in ESTADOS_OK_ETAPA or etapa is None \
+                or not mismo_pedido(build.get("pedido"), pedido_de_etapa(estado["pedido"], maestro, etapa)):
+            self.ui.aviso("No hay una etapa a medias para deshacer (todo lo que está en disco ya quedó verificado o "
+                          "la build pendiente no es de este proyecto grande).")
+            return False
+        grupo = build.get("grupo")
+        tocados = self.ws.checkpoints.deshacer(grupo) if grupo in self.ws.checkpoints.ids() else []
+        RegistroBuild(self.ws).borrar()
+        etapa.estado, etapa.motivo = "pendiente", f"deshecha a pedido ({len(tocados)} archivo(s) revertidos)"
+        etapa.intentos = 0                       # se rehace de cero: si no, "continuar" la frenaba por intentos viejos
+        estado["estado"] = "detenido"
+        estado["motivo"] = f"la etapa {etapa.id} se deshizo: /grande continuar la rehace desde el último estado verificado"
+        self.guardar(estado, maestro)
+        indice_de(self.ws).invalidar()
+        self.ui.ok(f"Etapa {etapa.id} deshecha: {len(tocados)} archivo(s) vuelven al último estado verificado.")
+        self.ui.tenue(f"  Para rehacerla: /grande continuar  ·  {comando_para_seguir(self.ws, 'grande', self.settings)}")
+        return True
+
+    def _detener(self, estado: dict, maestro: PlanMaestro, motivo: str) -> bool:
+        estado["estado"] = "detenido"
+        estado["motivo"] = motivo
+        rotas = {}
+        if "quedó" in motivo:                       # falló una etapa (no un corte del modelo): ¿rompió lo anterior?
+            try:
+                rotas = self.rotas_de_etapas_previas(maestro)
+            except (OSError, ValueError):
+                rotas = {}
+            if rotas:
+                estado["rotas_previas"] = rotas
+        self.guardar(estado, maestro)
+        hechas = sum(1 for e in maestro.etapas if e.ok)
+        self.ui.linea("")
+        cupo = motivo.startswith("se agotó el cupo diario")
+        primera, *resto = recortar(motivo, 300).splitlines() or [""]
+        self.ui.caja([f"Etapas verificadas: {hechas}/{len(maestro.etapas)}",
+                      f"Me detengo: {primera}", *resto,
+                      "Lo hecho queda guardado: nada se pierde." if cupo else
+                      "No construyo encima de algo que no está verificado.",
+                      "Cuando se renueve el cupo, seguí con: /grande continuar" if cupo else
+                      "Revisá el informe de la etapa y seguí con: /grande continuar"],
+                     titulo="Proyecto grande · DETENIDO", color=Tema.aviso)
+        if rotas:
+            detalle = "; ".join(f"etapa {eid}: {', '.join(n[:60] for n in nombres[:3])}" for eid, nombres in rotas.items())
+            self.ui.aviso(f"  Los cambios de esta etapa ROMPIERON lo que ya estaba verificado ({detalle}).")
+            self.ui.aviso("  Para volver al último estado verificado: /grande deshacer  (y después /grande continuar)")
+        # Fuera de la caja: adentro se recorta al ancho de la terminal y el comando no se podía copiar entero.
+        self.ui.info(f"  Desde la terminal: {comando_para_seguir(self.ws, 'grande', self.settings)}")
+        return False
+
+    # ------------------------------------------------------------ integración
+    def _integrar(self, estado: dict, maestro: PlanMaestro) -> bool:
+        """Todas las etapas verdes ≠ el pedido cumplido. Verificación real del proyecto ENTERO + juez contra el PEDIDO
+        ORIGINAL. Si falta algo: UNA build de integración con lo que falta y se vuelve a juzgar."""
+        self.ui.linea("")
+        self.ui.fase("G", "Integración final (todo el proyecto contra tu pedido original)")
+        pedido = estado["pedido"]
+        resultado = self._verificar_integracion(estado, maestro)
+        if not resultado["ok"] and not self._integracion_reparada:
+            faltas = resultado["faltantes"] or [_primera_linea_util(resultado["diagnostico"])]
+            self.ui.aviso("  Falta para cumplir el pedido completo: " + "; ".join(recortar(f, 80) for f in faltas[:4]))
+            estado["integracion"]["reparada"] = True
+            self._integracion_reparada = True
+            self.guardar(estado, maestro)
+            pedido_integracion = (
+                "PROYECTO GRANDE — INTEGRACIÓN FINAL. Todas las etapas están construidas y verificadas; NO rehagas "
+                "nada que funcione. Completá SOLO esto para que el proyecto cumpla el pedido original:\n"
+                + "\n".join(f"- {f}" for f in faltas[:8])
+                + (f"\n\nDiagnóstico real:\n{recortar(resultado['diagnostico'], 2500)}" if resultado["diagnostico"] else "")
+                + f"\n\nPEDIDO ORIGINAL DEL USUARIO:\n{recortar(pedido, 2500)}")
+            try:
+                informe = self._construir_build(pedido_integracion, False, pedido)
+            except LLMError as e:
+                informe = InformeBuild("fallida", diagnostico=str(e))
+            if informe.estado == "cancelada":
+                self.ui.aviso("  La build de integración no arrancó (otro /construir pendiente o plan inválido).")
+            resultado = self._verificar_integracion(estado, maestro)
+        estado["integracion"].update({k: resultado[k] for k in ("ok", "estado", "faltantes", "juicio")})
+        estado["estado"] = "terminado" if resultado["ok"] else "integracion_pendiente"
+        if resultado["ok"]:
+            estado.pop("motivo", None)              # el motivo de una parada anterior ya no vale (salía en /reporte)
+        else:
+            estado["motivo"] = "la integración final no quedó verificada: " + (
+                "; ".join(resultado["faltantes"][:3]) or _primera_linea_util(resultado["diagnostico"]))
+        self.guardar(estado, maestro)
+        return resultado["ok"]
+
+    def _verificar_integracion(self, estado: dict, maestro: PlanMaestro) -> dict:
+        orq = Orquestador(self.llm, self.ws, self.settings, self.ui)
+        orq.pedido_usuario = estado["pedido"]
+        try:
+            orq._huella_aceptacion = huella_aceptacion(self.ws)
+        except (ValueError, OSError):
+            orq._huella_aceptacion = None
+        cid = int(estado.get("cid_inicio") or 1)
+        verif = orq.verificar(cid)
+        orq._mostrar_verificacion(verif)
+        plan = Plan(maestro.vision or recortar(estado["pedido"], 200),
+                    [Tarea(e.id, f"{e.titulo}: {e.objetivo}", e.archivos, e.deps) for e in maestro.etapas],
+                    [c for e in maestro.etapas for c in e.criterios][:20],
+                    interfaz="\n".join(e.interfaz for e in maestro.etapas if e.interfaz))
+        informe = InformeBuild("fallida", plan=plan, cid=cid)
+        informe.estado = estado_final_build(verif, informe)
+        informe.criterios_entrega = orq._contrato_de_entrega(estado["pedido"])
+        orq._juicio_de_entrega(estado["pedido"], plan, verif, informe)
+        juicio = informe.juicio
+        faltantes = list(juicio.faltantes) if juicio is not None and juicio.valido and not juicio.cumple else []
+        return {"ok": informe.ok, "estado": informe.estado, "faltantes": faltantes,
+                "diagnostico": verif.diagnostico if not verif.ok else "",
+                "juicio": juicio.texto() if juicio is not None else "sin veredicto del juez"}
+
+    # ------------------------------------------------------------ salida
+    def _cierre(self, estado: dict, maestro: PlanMaestro, segundos: float) -> None:
+        integ = estado.get("integracion", {})
+        ok = estado.get("estado") == "terminado"
+        lineas = [f"{'✓' if e.ok else '✗'} Etapa {e.id} · {recortar(e.titulo, 36)}: {e.estado}"
+                  f" · {formatear_duracion(e.segundos)} · {e.pedidos} pedidos" for e in maestro.etapas]
+        lineas.append(f"Integración final: {integ.get('estado', '?')} · {recortar(str(integ.get('juicio', '')), 90)}")
+        if not ok:
+            lineas.append("Pendiente: " + recortar(str(estado.get("motivo", "")), 200))
+            lineas.append("Seguí con: /grande continuar (el comando completo va debajo)")
+        lineas.append(f"Tiempo de esta corrida: {formatear_duracion(segundos)}")
+        self.ui.linea("")
+        self.ui.caja(lineas, titulo="Proyecto grande · " + ("✓ TERMINADO Y VERIFICADO" if ok else "INCOMPLETO"),
+                     color=Tema.ok if ok else Tema.aviso)
+        if not ok:
+            self.ui.info(f"  Desde la terminal: {comando_para_seguir(self.ws, 'grande', self.settings)}")
+        ruta = self._guardar_informe(estado, maestro)
+        if ruta:
+            self.ui.tenue(f"  Informe: {ruta}")
+
+    def _guardar_informe(self, estado: dict, maestro: PlanMaestro) -> Optional[Path]:
+        lineas = [f"# Proyecto grande REAPER — {estado.get('estado', '?')}", "",
+                  f"Fecha: {datetime.now():%Y-%m-%d %H:%M}", "", "## Pedido", redactar_secretos(estado["pedido"]), "",
+                  "## Plan maestro", "```", maestro.como_texto(), "```", "", "## Etapas"]
+        for e in maestro.etapas:
+            lineas.append(f"- Etapa {e.id} · {e.titulo}: **{e.estado}** · intentos {e.intentos} · "
+                          f"{formatear_duracion(e.segundos)} · {e.pedidos} pedidos · ~{e.consumo} tokens"
+                          + (f" · informe: {e.informe}" if e.informe else ""))
+            if e.motivo and not e.ok:
+                lineas.append(f"  - motivo: {recortar(e.motivo, 400)}")
+        integ = estado.get("integracion", {})
+        lineas += ["", "## Integración final", f"- estado: {integ.get('estado', 'no corrió')}",
+                   f"- juez: {integ.get('juicio', '—')}"]
+        lineas += [f"- falta: {f}" for f in integ.get("faltantes", [])]
+        try:
+            carpeta = self.ws.carpeta_reaper() / "informes"
+            ruta = carpeta / f"proyecto_grande_{datetime.now():%Y%m%d_%H%M%S}.md"
+            escritura_atomica(ruta, "\n".join(lineas) + "\n")
+            return ruta
+        except OSError:
+            return None
+
+    def mostrar_estado(self) -> None:
+        try:
+            estado = self.leer()
+        except ValueError as e:
+            self.ui.error(str(e))
+            return
+        if not estado:
+            self.ui.tenue("No hay ningún proyecto grande en esta carpeta. Empezá uno con /grande <pedido>.")
+            return
+        maestro = self.maestro_de(estado)
+        hechas = sum(1 for e in maestro.etapas if e.ok)
+        self.ui.info(f"Proyecto grande ({estado.get('estado')}): {hechas}/{len(maestro.etapas)} etapas verificadas")
+        self.ui.tenue("  " + recortar(redactar_secretos(estado["pedido"]), 200))
+        self._mostrar_maestro(maestro)
+        if estado.get("motivo"):
+            self.ui.aviso("  Último motivo de parada: " + recortar(str(estado["motivo"]), 300))
+
+
+def _cmd_grande(self: "App", arg: str) -> None:
+    """/grande <pedido> | estado | continuar | descartar — proyecto grande construido por etapas verificadas."""
+    modo = arg.strip().lower()
+    grande = ConstructorGrande(self.llm, self.ws, self.settings, self.ui, construir_build=self._build_de_etapa)
+    if modo == "estado":
+        grande.mostrar_estado()
+        return
+    if modo == "descartar":
+        if self.ui.confirmar("¿Descartar el ESTADO del proyecto grande? Los archivos del proyecto no se borran."):
+            grande.borrar()
+            self.ui.ok("Estado del proyecto grande descartado; los archivos siguen intactos.")
+        return
+    if modo == "continuar":
+        grande.continuar()
+        return
+    if modo in ("deshacer", "volver"):
+        if self.ui.confirmar("¿Deshacer la etapa a medias y volver al último estado verificado? (las etapas "
+                             "verificadas no se tocan)", defecto=True):
+            grande.deshacer_etapa()
+        return
+    if not arg.strip():
+        self.ui.tenue("Uso: /grande <pedido> | estado | continuar | deshacer | descartar   "
+                      f"(hasta {self.settings.max_etapas} etapas; cada una es un /construir verificado)")
+        return
+    grande.iniciar(arg.strip(), confirmar=self.ui.interactivo and self.settings.modo != "auto")
+
+
+def _build_de_etapa(self: "App", pedido_etapa: str, reanudar: bool, pedido_usuario: str) -> "InformeBuild":
+    """Un /construir de etapa con la misma contabilidad que /construir (historial, estadísticas, hooks)."""
+    return self._construir_informe(pedido_etapa, confirmar=False, reanudar=reanudar, pedido_usuario=pedido_usuario)
+
+
+App.cmd_grande = _cmd_grande
+App._build_de_etapa = _build_de_etapa
