+def modelo_sano(settings, modelo: str, disyuntor=None) -> tuple:
+    """(sano, motivo). Sano = proveedor con credencial (o local), no retirado y sin el disyuntor abierto."""
+    retirados = globals().get("PROVEEDORES_RETIRADOS", frozenset())
