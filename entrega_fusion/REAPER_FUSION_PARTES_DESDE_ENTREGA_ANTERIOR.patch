+        orq = Orquestador(MockLLM(lambda m, k: terminar_xml("x")), ws, self.ajustes(), self.ui())
+        orq.reparar = lambda *a, **k: (_ for _ in ()).throw(_cupo_agotado(6 * 3600))
+        verif = orq.verificar(ws.checkpoints.iniciar("x"))
