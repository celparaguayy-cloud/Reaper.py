+@dataclass
+class CuentaOpenRouter:
+    """Lo que dice /api/v1/key de TU clave (no es un pedido a un modelo: no gasta cupo)."""
+    sin_credito: Optional[bool] = None          # is_free_tier: nunca compró créditos → 50 pedidos :free por día
