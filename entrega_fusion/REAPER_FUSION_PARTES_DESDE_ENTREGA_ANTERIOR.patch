+_CARGA_LIBRERIA = {
+    "ruby": lambda lib: ["ruby", "-e", f"require {lib!r}"],
+    "python3": lambda lib: [sys.executable, "-c", f"import {lib}"],
+    "node": lambda lib: ["node", "-e", f"require({lib!r})"],
