+    raw, _spec, suite = datos
+    h = hashlib.sha256(b'REAPER-810-ACCEPTANCE-V1\0' + raw)
+    for p in sorted(suite.rglob('test_*.py')):
+        h.update(str(p.relative_to(suite)).encode('utf-8') + b'\0')
