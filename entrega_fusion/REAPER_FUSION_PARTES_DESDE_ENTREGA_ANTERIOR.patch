+    if any(s in bajo for s in ("timeout", "timed out", "intentos")):
+        return "TIMEOUT", msg[:160]
+    if any(s in bajo for s in ("getaddrinfo", "name resolution", "connection refused", "no se pudo conectar", "dns")):
