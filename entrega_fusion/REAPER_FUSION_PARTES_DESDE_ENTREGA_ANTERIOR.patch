+class TestOpenRouterRealTareaYaHecha(BaseTest):
+    PLAN = """<plan>
+<objetivo>Conversor</objetivo>
+<interfaz>
+- conversor.py: def c_a_f(c) -> float; def f_a_c(f) -> float
