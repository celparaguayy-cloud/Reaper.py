+              "vision": ("vision", "visión", "overview"), "arquitectura": ("arquitectura", "architecture")}
+_SIN_DEPENDENCIAS = {"ninguna", "ninguno", "none", "no", "-", "—", "0", "n/a", "na", "nada", "[]"}
