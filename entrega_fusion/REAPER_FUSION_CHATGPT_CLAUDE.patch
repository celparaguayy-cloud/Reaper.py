+    try:
+        pedido = urllib.request.Request(URL_CATALOGO_OPENROUTER, headers={"User-Agent": "REAPER"})
+        with urllib.request.urlopen(pedido, timeout=timeout) as r:
+            lista = json.loads(r.read().decode("utf-8")).get("data", [])
