+                salida.append((rel, f"{tipo}: borró {borradas} de {total} líneas ({fraccion:.0%}) que ya había en "
+                                    f"{rel} antes de esta actualización. Extendé el archivo sin perder lo que ya "
+                                    f"hacía."))
