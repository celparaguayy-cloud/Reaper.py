+_FAMILIAS_PERMITIBLES = {
+    "ejemplo": (re.compile(r"ejemplo|example|sample|semilla|seed|demo", re.IGNORECASE),
+                re.compile(r"ejemplo|example|sample", re.IGNORECASE)),
