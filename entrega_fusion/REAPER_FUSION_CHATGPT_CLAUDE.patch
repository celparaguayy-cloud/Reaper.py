+            chequeos["n"] += 1
+            return chequeos["n"] > 2          # cancela al tercer chequeo
+
+        with self.assertRaises(LLMError):
+            c._dormir_cancelable(300.0, cancelado)
+        self.assertLessEqual(sum(tramos), 3.0)              # no esperó los 300 s
